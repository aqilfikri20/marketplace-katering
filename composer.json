{
  "name": "marketplace/katering",
  "type": "project",
  "description": "Marketplace katering untuk kantor dan merchant",
  "require": {"php": "^8.2", "laravel/framework": "^11.0", "laravel/tinker": "^2.9"},
  "require-dev": {"fakerphp/faker": "^1.23", "phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "dev": "php artisan serve"},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable", "prefer-stable": true
}
